{
  "luci-app-overlay-restore": {
    "description": "Inspect and apply OpenWrt backup migrations",
    "read": {
      "ubus": { "overlay-restore": ["list", "status", "usage", "devices", "local_feed_status"], "uci": ["get", "changes"], "file": ["stat"] },
      "file": { "/*": ["list"] },
      "uci": ["overlay_restore"]
    },
    "write": {
      "cgi-io": ["upload"],
      "file": { "/tmp/overlay-restore-upload.tar.gz": ["write"] },
      "ubus": { "overlay-restore": ["prepare", "prepare_local_feed", "apply", "retry", "cleanup", "remove", "rollback", "discard_overlay"], "uci": ["set", "delete", "commit", "revert"] },
      "uci": ["overlay_restore"]
    }
  }
}
