#!/bin/sh
set -u
CHAIN=docker_guard_pre
PERSIST=/etc/nftables.d/20-docker-guard.nft
RUNTIME=/run/docker-guard.runtime.nft
# Port exceptions belong to the router's local configuration, not the feed.
WHITELIST="$(uci -q get docker_exposure.settings.exempt_ports 2>/dev/null || true)"
log() { logger -t docker-guard "$*"; }

wan_iface() {
    i=$(ip -4 route show default 2>/dev/null | awk '/^default/{print $5; exit}')
    [ -n "${i:-}" ] || i=pppoe-wan
    echo "$i"
}

sections() {
    uci show docker_exposure 2>/dev/null | sed -n "s/^docker_exposure\.\([^.=]*\)=container$/\1/p"
}

docker_ok() {
    docker ps --format '{{.Names}}' >/dev/null 2>&1
}

# 输出: port proto name
compute_rules() {
    for sec in $(sections); do
        name=$(uci -q get "docker_exposure.$sec.name" 2>/dev/null)
        mode=$(uci -q get "docker_exposure.$sec.mode" 2>/dev/null)
        [ -n "$name" ] || continue
        [ "$mode" = "lan" ] || continue
        items=$(docker inspect "$name" --format '{{range $p, $b := .NetworkSettings.Ports}}{{range $b}}{{.HostPort}}|{{$p}} {{end}}{{end}}' 2>/dev/null)
        for it in $items; do
            port=${it%%|*}
            spec=${it#*|}
            proto=${spec##*/}
            case "$port" in ''|*[!0-9]*) continue ;; esac
            case "$proto" in tcp|udp) ;; *) continue ;; esac
            case " $WHITELIST " in *" $port "*)
                log "WARN container '$name' publishes whitelisted port $port -> NOT guarded (see LuCI exception list)"
                continue ;;
            esac
            echo "$port $proto $name"
        done
    done | sort -u
}

render_persist() {
    wan=$(wan_iface)
    echo "# generated by docker-guard $(date '+%F %T') - do not edit"
    echo "# hook prerouting priority -300, host ports, before Docker DNAT"
    echo "chain $CHAIN {"
    echo "    type filter hook prerouting priority -300; policy accept;"
    compute_rules | while read -r port proto name; do
        c=$(printf '%s' "$name" | tr -c 'a-zA-Z0-9_' '_')
        echo "    iifname \"$wan\" meta l4proto $proto th dport $port counter drop comment \"guard_$c\""
    done
    echo "}"
}

render_runtime() {
    wan=$(wan_iface)
    nft list chain inet fw4 "$CHAIN" >/dev/null 2>&1 && echo "delete chain inet fw4 $CHAIN"
    echo "table inet fw4 {"
    echo "  chain $CHAIN {"
    echo "    type filter hook prerouting priority -300; policy accept;"
    compute_rules | while read -r port proto name; do
        c=$(printf '%s' "$name" | tr -c 'a-zA-Z0-9_' '_')
        echo "    iifname \"$wan\" meta l4proto $proto th dport $port counter drop comment \"guard_$c\""
    done
    echo "  }"
    echo "}"
}

apply() {
    # Docker API 不可用 -> 保留现有规则，绝不生成空集
    if ! command -v docker >/dev/null 2>&1; then
        log "docker binary missing, keeping previous rules"
        return 1
    fi
    if ! docker_ok; then
        log "docker API unavailable, keeping previous rules"
        return 1
    fi
    render_persist > "$PERSIST.tmp"
    render_runtime > "$RUNTIME.tmp"
    if ! nft -c -f "$RUNTIME.tmp"; then
        log "runtime ruleset invalid, keeping previous"
        rm -f "$PERSIST.tmp" "$RUNTIME.tmp"
        return 1
    fi
    mv "$RUNTIME.tmp" "$RUNTIME"
    if ! nft -f "$RUNTIME"; then
        log "nft -f failed, keeping previous persist"
        return 1
    fi
    mv "$PERSIST.tmp" "$PERSIST"
    log "applied $(compute_rules | wc -l) rules on $(wan_iface)"
}

status() {
    printf 'chain=%s\n' "$CHAIN"
    printf 'wan_iface=%s\n' "$(wan_iface)"
    printf 'runtime_rules=%s\n' "$(nft list chain inet fw4 "$CHAIN" 2>/dev/null | grep -c 'comment "guard_')"
    printf 'persist_rules=%s\n' "$(grep -c 'drop comment' "$PERSIST" 2>/dev/null || echo 0)"
    printf 'docker_api=%s\n' "$(docker_ok && echo ok || echo unavailable)"
    printf 'service=%s\n' "$(ubus call service list '{"name":"docker-guard"}' 2>/dev/null | grep -q '"running": true' && echo running || echo stopped)"
    printf 'whitelist=%s\n' "$WHITELIST"
    # 例外面板：发布到白名单端口的容器
    for sec in $(sections); do
        name=$(uci -q get "docker_exposure.$sec.name" 2>/dev/null)
        mode=$(uci -q get "docker_exposure.$sec.mode" 2>/dev/null)
        items=$(docker inspect "$name" --format '{{range $p, $b := .NetworkSettings.Ports}}{{range $b}}{{.HostPort}} {{end}}{{end}}' 2>/dev/null)
        for p in $items; do
            case " $WHITELIST " in *" $p "*)
                printf 'exception=%s|%s|%s\n' "$name" "$p" "$mode" ;;
            esac
        done
    done
}

watch() {
    apply || true
    while :; do
        docker events --filter type=container \
            --filter event=start --filter event=stop --filter event=destroy \
            --format '{{.Action}}' 2>/dev/null | while read -r a; do
            case "$a" in start|stop|destroy) apply || true ;; esac
        done
        sleep 10
    done
}

check() {
    docker_ok || { log "docker API unavailable, skip check"; return 1; }
    want=$(compute_rules | wc -l)
    have=$(nft list chain inet fw4 "$CHAIN" 2>/dev/null | grep -c 'comment "guard_')
    [ "$want" = "$have" ] || { log "drift want=$want have=$have, reapplying"; apply || true; }
}

case "${1:-apply}" in
    apply) apply ;;
    watch) watch ;;
    check) check ;;
    status) status ;;
    *) echo "usage: $0 {apply|watch|check|status}"; exit 1 ;;
esac
