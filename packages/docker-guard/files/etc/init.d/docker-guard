#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

stop_service() { :; }

start_service() {
    /usr/libexec/docker-guard-setup || return 1
    procd_open_instance
    procd_set_param command /usr/bin/docker-guard watch
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
