#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
    if ! /bin/sh /usr/libexec/overlay-restore-bootstrap setup; then
        logger -p daemon.err -t overlay-restore-bootstrap 'Unable to retain recovery bootstrap files; reinstall overlay-restore before upgrading.'
    fi
    procd_open_instance
    procd_set_param command /usr/sbin/overlay-restore worker
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 3
    procd_close_instance
}
