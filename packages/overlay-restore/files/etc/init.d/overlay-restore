#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
    [ ! -f /etc/overlay-restore-bootstrap/run ] ||
        /bin/sh /etc/overlay-restore-bootstrap/run setup >/dev/null 2>&1 || true
    procd_open_instance
    procd_set_param command /usr/sbin/overlay-restore worker
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 3
    procd_close_instance
}
