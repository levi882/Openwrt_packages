#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
    local root="${OVERLAY_RESTORE_BOOTSTRAP_ROOT:-}"
    local directory="$root/etc/overlay-restore-bootstrap"
    local source=
    if [ ! -s "$directory/runner" ]; then
        if [ -s "$root/usr/libexec/overlay-restore-bootstrap" ]; then
            source="$root/usr/libexec/overlay-restore-bootstrap"
        elif [ -s "$directory/run" ]; then
            source="$directory/run"
        fi
        [ -z "$source" ] || /bin/sh "$source" setup
    fi
    if [ ! -s "$directory/runner" ]; then
        logger -p daemon.err -t overlay-restore-bootstrap 'Recovery bootstrap runner is missing; reinstall overlay-restore before upgrading.'
        if [ -d "$directory" ] && [ ! -L "$directory" ] && [ ! -L "$directory/boot.log" ]; then
            printf '%s Recovery bootstrap runner is missing.\n' "$(date '+%Y-%m-%d %H:%M:%S')" >> "$directory/boot.log"
        fi
        return 1
    fi
    if [ -f "$directory/files.sha256" ] &&
       ! (cd "$directory" && sha256sum -c files.sha256 >/dev/null 2>&1); then
        logger -p daemon.err -t overlay-restore-bootstrap 'Recovery bootstrap files are incomplete or modified; refusing to start.'
        return 1
    fi
    procd_open_instance
    procd_set_param command /bin/sh "$directory/runner" watch
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
