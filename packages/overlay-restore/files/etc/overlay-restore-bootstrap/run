#!/bin/sh

# This directory and the generated init hook are explicitly kept by sysupgrade.
# The init hook is generated rather than APK-owned: repairing this package must
# not stop its own installer through APK's default prerm service handling.
set -f
umask 077
bootstrap_root=$OVERLAY_RESTORE_BOOTSTRAP_ROOT
case "$bootstrap_root" in ''|/*) ;; *) exit 2 ;; esac
bootstrap_dir="$bootstrap_root/etc/overlay-restore-bootstrap"
logfile="$bootstrap_dir/boot.log"
lockdir="$bootstrap_root/tmp/overlay-restore-bootstrap.lock"
repofile="$bootstrap_root/etc/apk/repositories.d/00-myfeed.list"
default_repo=https://openwrt-packages.pages.dev/openwrt-25.12/x86_64/myfeed/packages.adb

config() {
    uci -c "$bootstrap_root/etc/config" -q get "overlay_restore.main.$1"
}

enabled() {
    [ "$(uci -c "$bootstrap_root/etc/config" -q get overlay_restore.main)" = restore ] || return 1
    bootstrap_enabled=$(config upgrade_bootstrap)
    [ -n "$bootstrap_enabled" ] || bootstrap_enabled=1
    [ "$bootstrap_enabled" = 1 ]
}

apk_command() {
    if [ -n "$local_cache" ]; then
        set -- --no-network --cache-dir "$local_cache" --repositories-file "$local_repositories" "$@"
    fi
    if [ -n "$bootstrap_root" ]; then
        apk --root "$bootstrap_root" --wait 30 --timeout 20 "$@"
    else
        apk --wait 30 --timeout 20 "$@"
    fi
}

prepare_local() {
    local_cache=
    local_repositories=
    local_directory=$(config local_feed_dir)
    restore_source=$(config restore_source)
    case "$restore_source" in
        online) return 0 ;;
        local) [ -n "$local_directory" ] || { log 'Local recovery requires a local feed directory.'; return 1; } ;;
        ''|auto) ;;
        *) log 'Invalid software recovery source.'; return 1 ;;
    esac
    [ -n "$local_directory" ] || return 0
    case "$local_directory" in /mnt/*|/media/*) ;; *) log 'Invalid local feed directory.'; return 1 ;; esac
    case "$local_directory" in *[[:space:]]*|*'..'*|*'$'*|*/upper/*|*/work/*) log 'Invalid local feed directory.'; return 1 ;; esac
    current="$bootstrap_root$local_directory/current"
    [ -f "$current" ] && [ ! -L "$current" ] || { log 'Waiting for the prepared local feed disk.'; return 1; }
    snapshot=$(cat "$current")
    case "$snapshot" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ "${#snapshot}" = 32 ] || return 1
    snapshot_directory="$bootstrap_root$local_directory/snapshots/$snapshot"
    [ -f "$snapshot_directory/repositories.list" ] && [ -f "$snapshot_directory/checksums.sha256" ] || return 1
    (cd "$snapshot_directory" && sha256sum -c checksums.sha256) >> "$logfile" 2>&1 || {
        log 'The local feed is incomplete or changed; prepare it again before upgrading.'
        return 1
    }
    local_cache="$local_directory/snapshots/$snapshot/cache"
    local_repositories="$snapshot_directory/repositories.list"
    log 'Using the signed local feed; repository network access is disabled.'
}

installed() {
    [ -x "$bootstrap_root/usr/sbin/overlay-restore" ] &&
        [ -x "$bootstrap_root/usr/libexec/rpcd/overlay-restore" ] &&
        [ -s "$bootstrap_root/www/luci-static/resources/view/system/overlay-restore.js" ] &&
        apk_command info -e overlay-restore >/dev/null 2>&1 &&
        apk_command info -e luci-app-overlay-restore >/dev/null 2>&1
}

firmware_fingerprint() {
    firmware_file="$bootstrap_root/rom/etc/openwrt_release"
    [ -s "$firmware_file" ] || firmware_file="$bootstrap_root/etc/openwrt_release"
    sha256sum "$firmware_file" | awk '{print $1}'
}

refresh_pending() {
    [ "$(cat "$bootstrap_dir/firmware.checked" 2>/dev/null)" = "$fingerprint" ] || return 0
    [ -f "$bootstrap_dir/refresh-pending" ] || return 1
    [ "$(cat "$bootstrap_dir/refresh-pending")" != "$(cat "$bootstrap_root/proc/sys/kernel/random/boot_id")" ]
}

recovery_idle() {
    jobs="$bootstrap_root/etc/overlay-restore/jobs"
    [ -d "$jobs" ] || return 0
    states=$(find "$jobs" -mindepth 2 -maxdepth 2 -type f -name state.json) || return 1
    printf '%s\n' "$states" | while IFS= read -r state; do
        [ -n "$state" ] || continue
        task_status=$(jsonfilter -i "$state" -e '@.status') || exit 1
        case "$task_status" in
            ready|complete|complete_with_warnings|failed_validation|rolled_back) ;;
            *) exit 1 ;;
        esac
    done
}

restore_hook() {
    [ -s "$bootstrap_dir/runner-init" ] || return 0
    cp "$bootstrap_dir/runner-init" "$bootstrap_root/etc/init.d/overlay-restore-bootstrap" || return 1
    chmod 0755 "$bootstrap_root/etc/init.d/overlay-restore-bootstrap"
}

trim_log() {
    [ -f "$logfile" ] || return 0
    logsize=$(wc -c < "$logfile")
    if [ "$logsize" -gt 65536 ]; then
        tail -c 65536 "$logfile" > "$logfile.tmp.$$" &&
            mv "$logfile.tmp.$$" "$logfile"
    fi
}

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$logfile"
    trim_log
    logger -t overlay-restore-bootstrap "$*" 2>/dev/null || true
}

setup() {
    # APK protects retained /etc files. Use the installed package's resources
    # so an older retained script cannot override a newly installed bootstrap.
    for resource in run init myfeed.pem; do
        case "$resource" in
            run) source="$bootstrap_root/usr/libexec/overlay-restore-bootstrap" ;;
            *) source="$bootstrap_root/usr/share/overlay-restore-bootstrap/$resource" ;;
        esac
        [ ! -s "$source" ] || cp "$source" "$bootstrap_dir/$resource" || return 1
    done
    [ -s "$bootstrap_dir/run" ] && [ -s "$bootstrap_dir/init" ] && [ -s "$bootstrap_dir/myfeed.pem" ] || return 1
    mkdir -p "$bootstrap_root/etc/init.d" || return 1
    # These generated copies survive installing an older tool from local cache.
    cp "$bootstrap_dir/run" "$bootstrap_dir/runner.tmp.$$" &&
        chmod 0700 "$bootstrap_dir/runner.tmp.$$" &&
        mv "$bootstrap_dir/runner.tmp.$$" "$bootstrap_dir/runner" || return 1
    cp "$bootstrap_dir/init" "$bootstrap_dir/runner-init.tmp.$$" &&
        mv "$bootstrap_dir/runner-init.tmp.$$" "$bootstrap_dir/runner-init" || return 1
    restore_hook || return 1
    if [ ! -e "$bootstrap_dir/firmware.checked" ]; then
        fingerprint=$(firmware_fingerprint) || return 1
        printf '%s\n' "$fingerprint" > "$bootstrap_dir/firmware.checked" || return 1
    fi
    if [ -n "$bootstrap_root" ]; then
        mkdir -p "$bootstrap_root/etc/rc.d" &&
            ln -sf ../init.d/overlay-restore-bootstrap "$bootstrap_root/etc/rc.d/S99overlay-restore-bootstrap"
    else
        /etc/init.d/overlay-restore-bootstrap enable
    fi
}

prepare_repository() {
    repository=$(config myfeed_repo)
    [ -n "$repository" ] || repository=$default_repo
    if [ -f "$repofile" ] && [ ! -L "$repofile" ]; then
        existing=$(awk '$1 ~ /^https:\/\// {print $1; exit}
            $1 == "@myfeed" && $2 ~ /^https:\/\// {print $2; exit}' "$repofile")
        [ -z "$existing" ] || repository=$existing
    fi
    case "$repository" in https://*) ;; *) log 'Refusing a non-HTTPS myfeed repository.'; return 1 ;; esac
    case "$repository" in *[[:space:]]*) log 'Invalid myfeed repository address.'; return 1 ;; esac
    [ ! -L "$repofile" ] || { log 'Refusing a symlinked repository file.'; return 1; }
    [ -s "$bootstrap_dir/myfeed.pem" ] || { log 'The retained signing key is missing.'; return 1; }
    mkdir -p "$bootstrap_root/etc/apk/keys" "$bootstrap_root/etc/apk/repositories.d" || return 1
    cp "$bootstrap_dir/myfeed.pem" "$bootstrap_root/etc/apk/keys/overlay-restore-bootstrap.pem" || return 1
    chmod 0644 "$bootstrap_root/etc/apk/keys/overlay-restore-bootstrap.pem" || return 1
    if [ -f "$repofile" ] && [ ! -e "$bootstrap_dir/repositories.before" ]; then
        cp "$repofile" "$bootstrap_dir/repositories.before" || return 1
    fi
    # Both the untagged and tagged entries are needed by existing APK worlds.
    touch "$repofile" || return 1
    if ! awk -v repo="$repository" '$1 == repo {found=1} END {exit !found}' "$repofile"; then
        printf '\n%s\n' "$repository" >> "$repofile" || return 1
    fi
    if ! awk -v repo="$repository" '$1 == "@myfeed" && $2 == repo {found=1} END {exit !found}' "$repofile"; then
        printf '@myfeed %s\n' "$repository" >> "$repofile" || return 1
    fi
}

package_operation() {
    if [ "$updating" = 1 ]; then
        apk_command --repositories-file "$lockdir/refresh.list" --cache-max-age 60 add --upgrade "$@" 'overlay-restore@myfeed>=0.2.0-r13' 'luci-app-overlay-restore@myfeed>=0.2.0-r19'
    elif [ "$repair" = 1 ]; then
        apk_command fix --reinstall --upgrade "$@" overlay-restore luci-app-overlay-restore
    else
        apk_command add "$@" 'overlay-restore@myfeed>=0.2.0-r13' 'luci-app-overlay-restore@myfeed>=0.2.0-r19'
    fi
}

safe_plan() {
    while IFS= read -r line; do
        case "$line" in
            \(*/*\)\ *)
                case "$line" in
                    *') Installing '*) ;;
                    *') Upgrading overlay-restore ('*|*') Upgrading luci-app-overlay-restore ('*|*') Reinstalling overlay-restore ('*|*') Reinstalling luci-app-overlay-restore ('*) ;;
                    *) log "Refusing an unrelated package change: $line"; return 1 ;;
                esac
                ;;
        esac
    done < "$lockdir/plan"
}

run() (
    enabled || return 0
    command -v apk >/dev/null 2>&1 || return 1
    fingerprint=$(firmware_fingerprint) || return 1
    installed && ! refresh_pending && return 0
    [ ! -L "$bootstrap_dir" ] && [ ! -L "$logfile" ] || return 1
    mkdir -p "$bootstrap_dir" "$bootstrap_root/tmp" || return 1
    chmod 0700 "$bootstrap_dir" || return 1
    mkdir "$lockdir" 2>/dev/null || return 0
    trap 'rm -f "$lockdir/plan" "$lockdir/refresh.list"; rmdir "$lockdir" 2>/dev/null' EXIT
    trap 'exit 1' HUP INT TERM
    release=$(sed -n "s/^DISTRIB_RELEASE=['\"]\\{0,1\\}\\([^'\"]*\\).*/\\1/p" "$bootstrap_root/etc/openwrt_release")
    case "$release" in 25.12|25.12.*) ;; *) log "Unsupported firmware release: $release"; return 1 ;; esac
    [ "$(apk_command --print-arch)" = x86_64 ] || { log 'Only the x86_64 myfeed is supported.'; return 1; }
    attempts=$OVERLAY_RESTORE_BOOTSTRAP_ATTEMPTS
    delay=$OVERLAY_RESTORE_BOOTSTRAP_DELAY
    [ -n "$attempts" ] || attempts=10
    [ -n "$delay" ] || delay=30
    case "$attempts:$delay" in *[!0-9:]*|:*|*:) return 2 ;; esac
    [ "$attempts" -ge 1 ] && [ "$attempts" -le 30 ] &&
        [ "$delay" -le 300 ] || return 2
    log 'Checking retained recovery tools after a firmware upgrade.'
    prepare_repository || return 1
    repair=0
    updating=0
    if apk_command info -e overlay-restore >/dev/null 2>&1 &&
        apk_command info -e luci-app-overlay-restore >/dev/null 2>&1; then
        repair=1
    fi
    attempt=1
    while ! installed && [ "$attempt" -le "$attempts" ]; do
        enabled || { log 'Automatic installation has been disabled.'; return 0; }
        log "Installation attempt $attempt of $attempts."
        if ! prepare_local; then
            attempt=$((attempt + 1))
            [ "$attempt" -gt "$attempts" ] || sleep "$delay"
            continue
        fi
        # A different configured feed may be temporarily unavailable. The APK
        # solver still checks signatures and whether our packages are available.
        apk_command update >> "$logfile" 2>&1
        trim_log
        if package_operation --simulate --no-logfile > "$lockdir/plan" 2>&1; then
            cat "$lockdir/plan" >> "$logfile"
            trim_log
            safe_plan || return 1
            package_operation >> "$logfile" 2>&1
            operation_result=$?
            restore_hook || return 1
            if [ "$operation_result" = 0 ] && installed; then
                log 'Recovery tools installed. Open System > Backup migration and confirm a recovery plan.'
                break
            fi
        else
            cat "$lockdir/plan" >> "$logfile"
        fi
        trim_log
        log 'Installation is not ready; check connectivity and repository signatures in this log.'
        attempt=$((attempt + 1))
        [ "$attempt" -gt "$attempts" ] || sleep "$delay"
    done
    if ! installed; then
        log 'Automatic installation stopped. Restart overlay-restore-bootstrap to retry.'
        return 1
    fi
    refresh_pending || return 0
    # Local recovery remains offline. Only the tool update reads the online feed.
    local_cache=
    local_repositories=
    updating=1
    printf '%s\n@myfeed %s\n' "$repository" "$repository" > "$lockdir/refresh.list" || return 1
    attempt=1
    while [ "$attempt" -le "$attempts" ]; do
        enabled || return 0
        recovery_idle || { log 'Waiting for recovery tasks to finish before updating tools.'; return 1; }
        log "Online tool update attempt $attempt of $attempts."
        # Refresh this signed feed separately: stale indices must not count as success.
        if apk_command --repositories-file "$lockdir/refresh.list" update >> "$logfile" 2>&1 &&
           package_operation --simulate --no-logfile > "$lockdir/plan" 2>&1; then
            cat "$lockdir/plan" >> "$logfile"
            trim_log
            safe_plan || return 1
            recovery_idle || { log 'Recovery started; postponing the tool update.'; return 1; }
            operation_result=0
            if awk '/^\( *[0-9]+\/[0-9]+\) / {found=1} END {exit !found}' "$lockdir/plan"; then
                package_operation >> "$logfile" 2>&1
                operation_result=$?
                restore_hook || return 1
            fi
            if [ "$operation_result" = 0 ] && installed; then
                printf '%s\n' "$fingerprint" > "$bootstrap_dir/firmware.checked.tmp.$$" &&
                    mv "$bootstrap_dir/firmware.checked.tmp.$$" "$bootstrap_dir/firmware.checked" || return 1
                rm -f "$bootstrap_dir/refresh-pending"
                log 'Recovery tools are current for this firmware. Other installed software is unchanged.'
                return 0
            fi
        fi
        trim_log
        attempt=$((attempt + 1))
        [ "$attempt" -gt "$attempts" ] || sleep "$delay"
    done
    log 'Online tool update is pending; installed recovery tools remain available.'
    return 1
)

watch() {
    while enabled; do
        run && return 0
        sleep 300
    done
}

case "$1" in
    setup) setup ;;
    run) run ;;
    watch) watch ;;
    status)
        if ! enabled; then printf 'disabled\n'
        elif installed; then printf 'installed\n'
        else printf 'missing\n'; fi
        ;;
    *) printf 'Usage: %s {setup|run|watch|status}\n' "$0" >&2; exit 2 ;;
esac
