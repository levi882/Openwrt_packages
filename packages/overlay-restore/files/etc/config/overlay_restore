config restore 'main'
	option keep_current_extroot '1'
	option keep_network '0'
	option restore_credentials '1'
	option reboot '1'
	option iptv_enable '1'
	option max_upload_mb '256'
	option max_expanded_mb '2048'
	option myfeed_repo 'https://openwrt-packages.pages.dev/openwrt-25.12/x86_64/myfeed/packages.adb'
	option myfeed_key_url 'https://openwrt-packages.pages.dev/public-key.pem'
	option iptv_repo_root '/mnt/sda1/iptv'
	option iptv_refresh_token ''
	option iptv_refresh_iface 'eth3.3927'
	option iptv_refresh_host '127.0.0.1'
	option iptv_refresh_port '9100'
	list iptv_refresh_allow_ips '127.0.0.1'
	list iptv_nginx_allow_ips '10.1.1.0/24'
	list iptv_nginx_allow_ips '127.0.0.1'
	option iptv_public_url 'http://10.1.1.1'
	option ha_config_root '/mnt/sda1/Configs/HomeAssistant'
